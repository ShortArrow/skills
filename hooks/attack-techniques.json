{
  "version": 1,
  "about": "Command shapes that match a MITRE ATT&CK technique. hooks/attack-guard.py reads it, and so may any other hook; the semantics are in that file's docstring.",
  "techniques": {
    "T1021.001": "Remote Services: Remote Desktop Protocol",
    "T1021.002": "Remote Services: SMB/Windows Admin Shares",
    "T1021.004": "Remote Services: SSH",
    "T1021.006": "Remote Services: Windows Remote Management",
    "T1572": "Protocol Tunneling",
    "T1090.001": "Proxy: Internal Proxy",
    "T1552.004": "Unsecured Credentials: Private Keys",
    "T1003.001": "OS Credential Dumping: LSASS Memory",
    "T1003.002": "OS Credential Dumping: Security Account Manager",
    "T1555.004": "Credentials from Password Stores: Windows Credential Manager",
    "T1027.010": "Obfuscated Files or Information: Command Obfuscation",
    "T1059.001": "Command and Scripting Interpreter: PowerShell",
    "T1564.003": "Hide Artifacts: Hidden Window",
    "T1053.005": "Scheduled Task/Job: Scheduled Task",
    "T1053.003": "Scheduled Task/Job: Cron",
    "T1543.003": "Create or Modify System Process: Windows Service",
    "T1547.001": "Boot or Logon Autostart Execution: Registry Run Keys / Startup Folder",
    "T1685": "Disable or Modify Tools",
    "T1686": "Disable or Modify System Firewall",
    "T1685.005": "Disable or Modify Tools: Clear Windows Event Logs",
    "T1070.003": "Indicator Removal: Clear Command History",
    "T1105": "Ingress Tool Transfer",
    "T1197": "BITS Jobs",
    "T1046": "Network Service Discovery",
    "T1047": "Windows Management Instrumentation",
    "T1070.009": "Indicator Removal: Clear Persistence",
    "canary": "attack-guard canary: a harmless fixed line that shows the hook is live"
  },
  "prefixes": ["sudo", "env", "nice", "nohup", "time", "command", "exec", "if", "elseif", "then", "else", "elif", "while", "until", "do", "!", "."],
  "runners": [
    {"commands": ["cmd"], "script_after": "^/[ck]$", "parse_as": "powershell"},
    {"commands": ["bash", "sh", "zsh", "dash"], "script_after": "^-c$", "parse_as": "bash"},
    {"commands": ["powershell", "pwsh"], "script_after": "^[-/](c|command)$", "parse_as": "powershell"},
    {"commands": ["start-process", "saps", "start"], "file_flag": "^-(filepath|f)$", "arguments_flag": "^-(argumentlist|args)$",
     "switches": "^-(nonewwindow|wait|passthru|usenewenvironment|loaduserprofile)$", "parse_as": "powershell"}
  ],
  "rules": [
    {"technique": "canary", "commands": ["echo", "write-output", "write-host"], "arguments": ["^attack-guard-canary$"],
     "always_deny": true},
    {"technique": "T1572", "commands": ["ssh", "plink"], "case_sensitive": true,
     "arguments": ["^-[46AaCfGgKkMNnqsTtVvXxYy]*[LRDW]"]},
    {"technique": "T1021.004", "commands": ["ssh", "plink", "scp", "sftp", "pscp"]},
    {"technique": "T1021.002", "commands": ["psexec", "psexec64", "paexec"]},
    {"technique": "T1021.006", "commands": ["enter-pssession", "etsn", "new-pssession", "nsn", "winrs", "winrm"]},
    {"technique": "T1021.006", "commands": ["invoke-command", "icm"],
     "arguments": ["^-(computername|cn|hostname|session|vmname)"]},
    {"technique": "T1021.001", "commands": ["mstsc"]},
    {"technique": "T1090.001", "commands": ["netsh"], "arguments": ["^portproxy$"]},
    {"technique": "T1686", "commands": ["netsh"], "arguments": ["^(adv)?firewall$", "^(off|disable)$"]},
    {"technique": "T1686", "commands": ["set-netfirewallprofile"], "flag_then_value": ["^-enabled$", "^(\\$?false|0)$"]},
    {"technique": "T1552.004", "commands": ["ssh-keygen"], "case_sensitive": true, "arguments": ["^-y$"]},
    {"technique": "T1552.004",
     "commands": ["cat", "type", "gc", "get-content", "more", "less", "head", "tail", "cp", "copy", "copy-item", "cpi",
                  "base64", "xxd", "od", "strings", "sls", "select-string", "grep", "rg", "findstr", "bat"],
     "arguments": ["(^|[\\\\/])\\.ssh[\\\\/](id_[^\\\\/.]+|[^\\\\/]+\\.pem)$|\\.(ppk|pfx|p12)$"]},
    {"technique": "T1003.001", "commands": ["procdump", "procdump64", "mimikatz"]},
    {"technique": "T1003.001", "commands": ["rundll32"], "arguments": ["minidump|comsvcs"]},
    {"technique": "T1003.002", "commands": ["reg"], "first_argument": "^(save|export)$",
     "arguments": ["^(hklm|hkey_local_machine)\\\\(sam|system|security)$"]},
    {"technique": "T1555.004", "commands": ["vaultcmd"]},
    {"technique": "T1555.004", "commands": ["cmdkey"], "arguments": ["^/l"]},
    {"technique": "T1555.004", "commands": ["rundll32"], "arguments": ["keymgr"]},
    {"technique": "T1027.010", "commands": ["powershell", "pwsh", "powershell_ise"],
     "stop_at": "^[-/](c|command|f|file|cwa|commandwithargs)$",
     "arguments": ["^[-/](ec|e(n(c(o(d(e(d(c(o(m(m(a(n(d)?)?)?)?)?)?)?)?)?)?)?)?)?)$"]},
    {"technique": "T1059.001", "commands": ["powershell", "pwsh", "powershell_ise"],
     "stop_at": "^[-/](c|command|f|file|cwa|commandwithargs)$",
     "flag_then_value": ["^[-/](ex|ep|exe(c(u(t(i(o(n(p(o(l(i(c(y)?)?)?)?)?)?)?)?)?)?)?)?)$", "^(bypass|unrestricted)$"]},
    {"technique": "T1564.003", "commands": ["powershell", "pwsh", "powershell_ise"],
     "stop_at": "^[-/](c|command|f|file|cwa|commandwithargs)$",
     "flag_then_value": ["^[-/](w|wi(n(d(o(w(s(t(y(l(e)?)?)?)?)?)?)?)?)?)$", "^hidden$"]},
    {"technique": "T1564.003", "commands": ["start-process", "saps", "start"], "flag_then_value": ["^-windowstyle$", "^hidden$"]},
    {"technique": "T1059.001", "commands": ["set-executionpolicy"], "arguments": ["^(bypass|unrestricted)$"]},
    {"technique": "T1053.005", "commands": ["schtasks"], "arguments": ["^/(create|change)$"]},
    {"technique": "T1053.005", "commands": ["register-scheduledtask", "set-scheduledtask"]},
    {"technique": "T1070.009", "commands": ["schtasks"], "arguments": ["^/delete$"]},
    {"technique": "T1047", "commands": ["wmic"], "arguments": ["^process$", "^call$", "^create$"]},
    {"technique": "T1047", "commands": ["invoke-cimmethod", "invoke-wmimethod"], "arguments": ["^win32_process$", "^create$"]},
    {"technique": "T1053.003", "commands": ["crontab"], "not_first_argument": "^-l$"},
    {"technique": "T1543.003", "commands": ["sc"], "shells": ["bash"], "or_exe": true, "first_argument": "^(create|config)$"},
    {"technique": "T1543.003", "commands": ["new-service"]},
    {"technique": "T1547.001", "commands": ["reg"], "first_argument": "^add$", "arguments": ["currentversion\\\\run(once)?(ex)?(\\\\|$)"]},
    {"technique": "T1547.001", "commands": ["set-itemproperty", "sp", "new-itemproperty"],
     "arguments": ["currentversion\\\\run(once)?(ex)?(\\\\|$)"]},
    {"technique": "T1547.001", "commands": ["copy-item", "cpi", "copy", "cp", "move-item", "mi", "move", "mv", "new-item", "ni",
                                               "set-content", "sc", "add-content", "ac", "out-file", "tee-object", "tee"],
     "arguments": ["start menu[\\\\/]programs[\\\\/]startup"]},
    {"technique": "T1685", "commands": ["set-mppreference"], "arguments": ["^-(disable|exclusion)"]},
    {"technique": "T1685", "commands": ["add-mppreference"], "arguments": ["^-exclusion"]},
    {"technique": "T1685.005", "commands": ["wevtutil"], "first_argument": "^(cl|clear-log)$"},
    {"technique": "T1685.005", "commands": ["clear-eventlog", "remove-eventlog"]},
    {"technique": "T1070.003", "commands": ["history"], "arguments": ["^-c$"]},
    {"technique": "T1070.003", "commands": ["clear-history", "clhy"]},
    {"technique": "T1105", "commands": ["certutil"], "arguments": ["^[-/](urlcache|verifyctl)$|^https?://"]},
    {"technique": "T1197", "commands": ["bitsadmin"], "arguments": ["^/(transfer|addfile|create|setnotifycmdline)$"]},
    {"technique": "T1197", "commands": ["start-bitstransfer"]},
    {"technique": "T1105", "commands": ["curl", "wget", "iwr", "invoke-webrequest", "irm", "invoke-restmethod"],
     "arguments": ["\\.(exe|dll|msi|ps1|psm1|bat|cmd|vbs|hta|scr|com)($|\\?)"]},
    {"technique": "T1046", "commands": ["nmap", "masscan", "zmap", "rustscan", "nbtscan", "netscan", "nc", "ncat", "netcat"]},
    {"technique": "T1046", "commands": ["test-netconnection", "tnc"], "arguments": ["^-p|^-commontcpport|^[0-9]+$"]},
    {"technique": "T1105", "scope": "line",
     "any_command": ["curl", "wget", "iwr", "invoke-webrequest", "irm", "invoke-restmethod"],
     "any_piped_command": ["sh", "bash", "zsh", "dash", "iex", "invoke-expression", "powershell", "pwsh"]},
    {"technique": "T1105", "scope": "line", "any_command": ["iex", "invoke-expression"],
     "line": "\\b(iwr|irm|curl|wget|invoke-webrequest|invoke-restmethod)\\b|downloadstring|downloadfile"},
    {"technique": "T1070.003", "scope": "line", "any_command": ["remove-item", "ri", "rm", "del", "erase", "clear-content", "clc"],
     "line": "historysavepath|consolehost_history|\\.(bash|zsh)_history"},
    {"technique": "T1046", "scope": "line", "line": "[<>]\\s*/dev/tcp/"}
  ]
}
