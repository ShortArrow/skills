{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/hooks/upstream-behind.py\" || true",
            "shell": "bash",
            "timeout": 60,
            "statusMessage": "Checking vendored forks against their upstream"
          }
        ]
      }
    ]
  }
}
